# Serves the built website on port 32773 (plain HTTP). HTTPS and the domain are handled by the
# reverse proxy in front of it on the VPS.
{
	admin off
	auto_https off
	persist_config off
}

:32773 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Vite's hashed bundles never change; images revalidate weekly; pages always revalidate.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@images path *.webp *.png *.svg
	header @images Cache-Control "public, max-age=604800"
	@pages path / */ *.html
	header @pages Cache-Control "no-cache"

	# Also redirects directory URLs such as /privacy/en (linked from the app) to /privacy/en/.
	file_server

	# Unknown paths go to the home page.
	handle_errors {
		@notFound expression {err.status_code} == 404
		redir @notFound / 302
	}
}
